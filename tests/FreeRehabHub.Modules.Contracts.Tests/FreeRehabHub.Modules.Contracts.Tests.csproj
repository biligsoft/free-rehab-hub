<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FreeRehabHub.Modules.Contracts\FreeRehabHub.Modules.Contracts.csproj" />
    <ProjectReference Include="..\..\modules\com.freerehabhub.general-functional-checkin\GeneralFunctionalCheckin.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ModuleRegistry testleri gerçek bir modül klasör düzenini taramalı; general-functional-checkin'in
         manifest.json + .csproj'unu (ModuleRegistry, assembly adını .csproj dosya adından türetiyor)
         test çıktısında ayrı bir "modules kökü" altına kopyalıyoruz. -->
    <None Include="..\..\modules\com.freerehabhub.general-functional-checkin\manifest.json"
          Link="TestModulesRoot\com.freerehabhub.general-functional-checkin\manifest.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\modules\com.freerehabhub.general-functional-checkin\GeneralFunctionalCheckin.csproj"
          Link="TestModulesRoot\com.freerehabhub.general-functional-checkin\GeneralFunctionalCheckin.csproj">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
